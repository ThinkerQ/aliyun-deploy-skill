# 复制为 .env 并填写。使用 Bash 赋值语法，特殊字符需正确引用。
XINYA_DOCKER_DIR='/path/to/xinya_ry/docker'
ACR_REGISTRY='registry.example.com'
ACR_NAMESPACE='example'
ACR_USER=''
ACR_PASSWORD=''
ECS_HOST=''
ECS_PRIVATE_HOST=''
ECS_USER='root'
ECS_PASSWORD=''
ECS_SSH_KEY=''
ALIYUN_ACCOUNT_ID=''
PUBLIC_BASE_URL='https://example.com'
MYSQL_ROOT_PASSWORD=''
MYSQL_USER='xinya'
MYSQL_PASSWORD=''
MYSQL_DATABASE='xinya_hours'
APP_ADMIN_USER=''
APP_ADMIN_PASSWORD=''
# APP_ADMIN_* 仅记录初始化账号，不会更改已有数据库或后台口令。
